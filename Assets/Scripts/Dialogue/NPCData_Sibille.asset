%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3cfcc847ff55621408fab318190586b0, type: 3}
  m_Name: NPCData_Sibille
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue.NPCData
  m_NPCID: 3
  m_NPCName: Sibille
  m_NPCPortrait: {fileID: 10915, guid: 0000000000000000f000000000000000, type: 0}
  m_startNodeID: 0
  m_nodes:
  - m_NodeID: 0
    m_text: 'Oh, hallo, du bist neu hier oder?

      Moment, ist das etwa...Rainers
      Boot?

      Dann musst du sein Enkel sein. Ich bin Sibille. '
    m_responses:
    - m_responseText: Ja, Ich bin Harald. Wolfgang schickt mich um mit dir zu reden
        und auf dem Weg das Boot zu testen.
      m_nextNodeID: 1
      m_actionType: 2
      m_quest: {fileID: 11400000, guid: d7aede8d842782940abc6794ac9e08bc, type: 2}
  - m_NodeID: 1
    m_text: "Das ist aber sch\xF6n. Und? Wie l\xE4uft die alte Kiste? "
    m_responses:
    - m_responseText: "Bisher ganz gut, aber ich brauche noch \xDCbung"
      m_nextNodeID: 2
      m_actionType: 0
      m_quest: {fileID: 0}
    - m_responseText: Geht so, ist alles ziemlich kompliziert
      m_nextNodeID: 3
      m_actionType: 0
      m_quest: {fileID: 0}
  - m_NodeID: 2
    m_text: "Na dann. Sch\xF6n flei\xDFig weiter \xFCben. H\xF6r dich in den H\xE4fen
      um, es gibt immer etwas zu tun. "
    m_responses:
    - m_responseText: "Klar, mach ich. Sch\xF6n dich kennengelernt zu haben"
      m_nextNodeID: 4
      m_actionType: 0
      m_quest: {fileID: 0}
  - m_NodeID: 3
    m_text: "Ach, mit ein wenig \xDCbung wird das schon "
    m_responses:
    - m_responseText: "Dann geh ich mal weiter \xFCben. Sch\xF6n dich kennengelernt
        zu haben"
      m_nextNodeID: 4
      m_actionType: 0
      m_quest: {fileID: 0}
  - m_NodeID: 4
    m_text: "War auch sch\xF6n dich kennengelernt zu haben. Bis bald"
    m_responses:
    - m_responseText: 'Bis bald [gehen]'
      m_nextNodeID: -1
      m_actionType: 0
      m_quest: {fileID: 0}
